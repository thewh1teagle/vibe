+// No exception may leave the backend through its C interface: a caller that is not C++ (Rust,
+// or C) cannot unwind one, and the process aborts. Every interface entry below goes through
+// these, logs what happened, and reports failure the way that entry can.
+template <typename F>
+static void ggml_vk_guard(const char * what, F && fn) {
+    try {
+        fn();
+    } catch (const std::exception & e) {
+        GGML_LOG_ERROR("ggml_vulkan: %s failed: %s\n", what, e.what());
+    } catch (...) {
+        GGML_LOG_ERROR("ggml_vulkan: %s failed with an unknown exception\n", what);
+    }
+}
+
+template <typename R, typename F>
+static R ggml_vk_guard(const char * what, R fallback, F && fn) {
+    try {
+        return fn();
+    } catch (const std::exception & e) {
+        GGML_LOG_ERROR("ggml_vulkan: %s failed: %s\n", what, e.what());
+    } catch (...) {
+        GGML_LOG_ERROR("ggml_vulkan: %s failed with an unknown exception\n", what);
+    }
+    return fallback;
+}
